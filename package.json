{
  "name": "soundboard",
  "version": "1.0.2",
  "description": "Soundboard Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npx vite\" \"wait-on tcp:5173 && node electron/launcher.js\"",
    "dev:vite": "npx vite",
    "dev:electron": "node electron/launcher.js",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder --win --x64",
    "dist:dir": "vite build && electron-builder --win --x64 --dir",
    "icon": "node scripts/generate-icon.js",
    "release": "npm version patch --no-git-tag-version && node scripts/generate-icon.js && vite build && electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.soundboard.app",
    "productName": "Soundboard",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "forceCodeSigning": false,
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "elifnurdemir",
      "repo": "soundboard",
      "releaseType": "release"
    },
    "icon": "build-assets/icon.ico",
    "win": {
      "icon": "build-assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Soundboard"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "uuid": "^9.0.1",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.2"
  }
}
